# good-pdc environment template.
# Copy to `.env` and fill in as needed. Everything here is OPTIONAL — the app
# runs with sensible defaults when these are unset.

# --- Observability ---
# Sentry DSN for error/performance monitoring. Leave empty to disable Sentry.
SENTRY_DSN=
# Log verbosity: error | warn | info | debug | trace
LOG_LEVEL=info

# --- Performance ---
# Max datasets processed concurrently (default: 8).
MAX_CONCURRENCY=8
# Hours before a cached dataset file is re-downloaded (default: 24; 0 = every run).
DATASET_REFRESH_HOURS=24

# --- Deep data-quality pass (optional, heavier; good for a weekly schedule) ---
# Set to 1/true to also check blank/duplicate rows, empty columns, long headers,
# stray whitespace, and header naming consistency.
DEEP_ANALYSIS=0

# --- Dolt export (optional; requires the Dolt integration / PR #36) ---
# Master switch for mirroring results into a Dolt database (kingfish/CMS-PDC).
DOLT_ENABLED=0
# Run `dolt push` after committing locally.
DOLT_PUSH=0
# Local working clone of the Dolt repo (from `dolt clone kingfish/CMS-PDC dolt-data`).
DOLT_REPO_DIR=dolt-data
# Push target remote / branch.
DOLT_REMOTE=origin
DOLT_BRANCH=main
# DoltHub API token, used to authenticate the `dolt` CLI for pushing.
# Create one at https://www.dolthub.com/settings/credentials
DOLTHUB_TOKEN=
